MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2

[preset00]

fRating=5.000
fGammaAdj=1.000

; ================================================================
; FRAME / HISTORY
; ================================================================

fDecay=1.000

fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0

zoom=1.00000
rot=0.00000

cx=0.500
cy=0.500

dx=0.00000
dy=0.00000

warp=0.00000

sx=1.00000
sy=1.00000


; ================================================================
; BUILT-IN WAVE OFF
; ================================================================

nWaveMode=0

bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0

fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.000
fWaveParam=0.000


; ================================================================
; WAVE 0 – SOLID FILL (thick line)
; ================================================================

wavecode_0_enabled=1
wavecode_0_sep=80
wavecode_0_bSpectrum=1
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1          ; Thick line for fill
wavecode_0_bAdditive=0
wavecode_0_r=1.000
wavecode_0_g=1.000
wavecode_0_b=1.000
wavecode_0_a=1.000

wave_0_per_frame1=r=1;
wave_0_per_frame2=g=1;
wave_0_per_frame3=b=1;
wave_0_per_frame4=a=1;
wave_0_per_frame5=samples=200;


; ================================================================
; SPECTRUM POINT – Fill Wave
; ================================================================

; Horizontal placement: central 40% (30% margins)
wave_0_per_point1=x=0.30 + sample * 0.40;

; Amplitude calculation (must match the peak wave)
wave_0_per_point2=t1=abs(value1);
wave_0_per_point3=edge=0.5 - 0.5*cos(6.28318*sample);
wave_0_per_point4=t1 = t1 * edge;
wave_0_per_point5=t1=pow(t1, 0.60);
wave_0_per_point6=t1=t1 * 0.55;

; Thickness: slightly larger than the peak height to cover from baseline upward
wave_0_per_point7=thick=t1 * 1.1;

; Center the thick line at the midpoint between baseline and peak
wave_0_per_point8=y=0.10 + t1/2.0;


; ================================================================
; WAVE 1 – THIN PEAK (the mountain crest)
; ================================================================

wavecode_1_enabled=1
wavecode_1_sep=80
wavecode_1_bSpectrum=1
wavecode_1_bUseDots=0
wavecode_1_bDrawThick=0          ; Thin line
wavecode_1_bAdditive=0
wavecode_1_r=1.000
wavecode_1_g=1.000
wavecode_1_b=1.000
wavecode_1_a=1.000

wave_1_per_frame1=r=1;
wave_1_per_frame2=g=1;
wave_1_per_frame3=b=1;
wave_1_per_frame4=a=1;
wave_1_per_frame5=samples=200;


; ================================================================
; SPECTRUM POINT – Peak Wave
; ================================================================

; Same horizontal mapping
wave_1_per_point1=x=0.30 + sample * 0.40;

; Same amplitude calculation
wave_1_per_point2=t1=abs(value1);
wave_1_per_point3=edge=0.5 - 0.5*cos(6.28318*sample);
wave_1_per_point4=t1 = t1 * edge;
wave_1_per_point5=t1=pow(t1, 0.60);
wave_1_per_point6=t1=t1 * 0.55;

; Thin line at the peak position
wave_1_per_point7=y=0.10 + t1;


; ================================================================
; HISTORY TRACE – Shift and Sharpen
; ================================================================

warp_1=shader_body
warp_2={

; Dense line spacing (no fading)
warp_3=float traceStep=0.0065;

warp_4=float2 historyUV;
warp_5=historyUV.x=uv.x;

; Move previous frame upward
warp_6=historyUV.y=uv.y + traceStep;

; Black background
warp_7=ret=float3(0.0,0.0,0.0);

; Read previous frame if within bounds
warp_8=if(
warp_9=    historyUV.y>=0.0 &&
warp_10=    historyUV.y<=1.0
warp_11=)
warp_12={
warp_13=    ret=tex2D(
warp_14=        sampler_main,
warp_15=        historyUV
warp_16=    ).xyz;

; --- Threshold to remove blur and keep edges crisp ---
; Any value >= 0.5 becomes pure white, otherwise black.
warp_17=    ret = (ret.x >= 0.5) ? float3(1.0,1.0,1.0) : float3(0.0,0.0,0.0);
warp_18=}

warp_19=}


; ================================================================
; COMPOSITE
; ================================================================

comp_1=shader_body
comp_2={
comp_3=ret=tex2D(
comp_4=    sampler_main,
comp_5=    uv
comp_6=).xyz;
comp_7=}
